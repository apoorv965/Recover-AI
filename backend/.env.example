# Copy this file to .env and fill in real values. Never commit .env.

# Google OAuth 2.0 Client ID (Web application type) from
# https://console.cloud.google.com/apis/credentials
# Must match the client ID used by the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Secret used to sign our own session JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-value

# How long a session stays valid, in minutes. Default: 7 days.
JWT_EXPIRE_MINUTES=10080

# Optional: DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/recoverai
